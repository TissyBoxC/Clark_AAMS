      "expectedRanges": [
        [
          1,
          3
        ]
      ],
      "expectedRule": "ALL",
      "expectedExpand": [
        1,
        2,
        3
      ]
    },
    {
      "name": "越界周次被丢弃",
      "weeks": [
        0,
        1,
        2,
        31,
        99
      ],
      "expectedRanges": [
        [
          1,
          2
        ]
      ],
      "expectedRule": "ALL",
      "expectedExpand": [
        1,
        2
      ]
    },
    {
      "name": "空输入",
      "weeks": [],
      "expectedRanges": [],
      "expectedRule": "ALL",
      "expectedExpand": []
    },
    {
      "name": "非连续周次拆成多段",
      "weeks": [
        1,
        2,
        5,
        6,
        9
      ],
      "expectedRanges": [
        [
          1,
          2
        ],
        [
          5,
          6
        ],
        [
          9,
          9
        ]
      ],
      "expectedRule": "ALL",
      "expectedExpand": [
        1,
        2,
        5,
        6,
        9
      ]
    }
  ],
  "endTime": [
